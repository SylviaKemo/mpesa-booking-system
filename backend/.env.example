# Copy to .env and adjust. .env is gitignored and must never be committed.

# SQLite locally; swap for a Postgres URL in production, e.g.
# postgresql+psycopg://user:password@host:5432/shamim
# Percent-encode special characters in the password (@ becomes %40).
DATABASE_URL=sqlite:///./shamim.db

# Origins allowed to call the API, comma-separated.
# "*" is accepted in development only, and disables credentialed CORS because
# echoing any caller's origin back with credentials would open the API to any
# site. Setting it with ENVIRONMENT=production refuses to start.
CORS_ORIGINS=http://localhost:3000

# The salon's wall clock. Whether a slot has already passed is a question about
# Nairobi, not about wherever the server runs — a UTC host would otherwise treat
# a finished day as bookable for three hours every night.
SALON_TIMEZONE=Africa/Nairobi

# How far ahead bookings may be made.
MAX_BOOKING_LEAD_DAYS=180

# "production" refuses a wildcard CORS_ORIGINS. Use it when deployed.
ENVIRONMENT=development
